# Copy to .env.local for running the binaries ON YOUR HOST -- `go run ./cmd/api`,
# `make migrate`, `make test-local`. The hostnames below are localhost for that
# reason.
#
# The Docker stack does NOT read this file. `make up` is configured entirely by
# the environment: block in docker/docker-compose.dev.yml, where the services
# reach each other by name (postgres:5432, redis:6379) rather than localhost.
# To override a value there, export it in your shell: JWT_SECRET=x make up
ENV=local
PORT=8000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/go_backend_template?sslmode=disable
REDIS_URL=redis://localhost:6380
# python -c "import secrets; print(secrets.token_urlsafe(50))"
JWT_SECRET=change-me-in-dev
LOG_LEVEL=debug

# Comma-separated exact-match browser origins allowed to call this API.
# Empty (default) = CORS disabled, no CORS headers emitted.
CORS_ALLOWED_ORIGINS=

# Comma-separated CIDRs of reverse proxies allowed to set X-Forwarded-For.
# Empty (default) = the server is directly reachable; X-Forwarded-For is
# ignored entirely. Running locally without a proxy, leave this empty.
TRUSTED_PROXIES=
