ENV=local
PORT=8000
DATABASE_URL=postgres://postgres:postgres@localhost:5433/go_backend_template?sslmode=disable
REDIS_URL=redis://localhost:6380
JWT_SECRET=change-me-in-dev
LOG_LEVEL=debug

# Comma-separated exact-match browser origins allowed to call this API.
# Empty (default) = CORS disabled, no CORS headers emitted.
CORS_ALLOWED_ORIGINS=

# Comma-separated CIDRs of reverse proxies allowed to set X-Forwarded-For.
# Empty (default) = the server is directly reachable; X-Forwarded-For is
# ignored entirely. Running locally without a proxy, leave this empty.
TRUSTED_PROXIES=
