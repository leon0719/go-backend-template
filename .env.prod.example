ENV=prod
PORT=8000
DATABASE_URL=postgres://user:password@db-host:5432/go_backend_template?sslmode=require
REDIS_URL=redis://redis-host:6379
#python -c "import secrets; print(secrets.token_urlsafe(50))"
JWT_SECRET=change-me-to-a-long-random-value
# Comma-separated exact-match browser origins allowed to call this API.
# Empty = CORS disabled (no CORS headers emitted). Set this to your frontend
# origin(s), e.g. https://app.example.com
CORS_ALLOWED_ORIGINS=

# Comma-separated CIDRs of reverse proxies allowed to set X-Forwarded-For.
# The bundled caddy service runs on the Compose-created Docker bridge network,
# which Docker allocates out of 172.16.0.0/12 by default — so caddy's peer
# address always falls inside this range. WITHOUT this set, every request
# looks like it comes from Caddy and all clients share one rate-limit bucket.
# SECURITY: never widen this to 0.0.0.0/0 — that lets any client spoof its IP
# via X-Forwarded-For and bypass IP rate limiting entirely. If your proxy runs
# elsewhere, narrow this to that proxy's exact address (e.g. 10.0.1.5/32).
TRUSTED_PROXIES=172.16.0.0/12

ARTICLE_PUBLISHED_WEBHOOK_URL=
GIT_COMMIT_SHA=
DOMAIN=example.com
